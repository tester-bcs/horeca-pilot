# Сценарий №2: возвраты и рекламации (HoReCa)
# Соглашения BRANCH/MERGE/VERIFY/POLICY — см. horeca-daily-cycle.luck (шапка).

NODE intake_return: STEP [GENERATIVE]
  DO "принять рекламацию клиента: товар, причина, документы"
  VERIFY checker="not_empty"
  INTO return_doc
END

NODE classify_return: CLASSIFY [GENERATIVE]
  INPUT "причина возврата: брак производства, повреждение при доставке, просрочка, не тот товар"
  LABELS defect="брак", damaged="повреждение", expired="просрочка", wrong_item="пересорт"
  INTO return_reason
END

NODE scrap_replace: STEP [GENERATIVE]
  DO "списать брак, выдать замену клиенту за счёт производства"
  INTO scrap_doc
END

NODE replace_ship: STEP [GENERATIVE]
  DO "выдать замену за счёт доставки, оформить претензию перевозчику"
  INTO ship_claim
END

NODE credit_note: STEP [GENERATIVE]
  DO "списать просроченный товар, оформить кредит-ноту клиенту"
  INTO credit_doc
END

NODE restock: STEP [GENERATIVE]
  DO "принять товар обратно на склад, разобрать пересорт"
  INTO restock_doc
END

NODE settle: STEP [GENERATIVE]
  DO "провести возврат по складу и деньгам: списания, замены, кредит-ноты"
  INTO settlement
END

NODE returns_report: STEP [GENERATIVE]
  DO "сформировать отчёт по возвратам: причины, суммы, тренд"
  INTO returns_report_doc
END

EDGES:
  intake_return -> classify_return
  classify_return => scrap_replace [брак]
  classify_return => replace_ship [повреждение]
  classify_return => credit_note [просрочка]
  classify_return => restock [пересорт]
  scrap_replace ~> settle
  replace_ship ~> settle
  credit_note ~> settle
  restock ~> settle
  settle -> returns_report
END
