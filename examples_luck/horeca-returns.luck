# Сценарий №2: возвраты и рекламации (HoReCa)
# Обратный материальный поток (Срез 5 — отказы/восстановление).
# Паттерн ветвления: CLASSIFY (причина) -> BRANCH-узел -> ветки.

# --- Приём рекламации от клиента (A5 Торговля, обратный поток) ---
NODE intake_return: STEP
  DO "принять рекламацию клиента: товар, причина, документы"
  INTO return_doc
END

# --- Форма честна (Срез 4): рекламация зафиксирована ---
NODE verify_return: VERIFY
  VERIFY not_empty INTO return_doc
END

# --- Классификация причины возврата (Срез 5 — состояние отказа) ---
NODE classify_return: CLASSIFY
  AS "Ты классификатор причин возврата. Ответь РОВНО одним словом: defect (брак производства), damaged (повреждение при доставке), expired (просрочка) или wrong_item (не тот товар). Никаких пояснений."
  DO "классифицировать причину возврата: брак производства, повреждение при доставке, просрочка, не тот товар"
  INPUT return_doc
  INTO return_reason
END

# --- Ветвление по причине ---
NODE fork_return: BRANCH
  INPUT return_reason
  BRANCHES defect=scrap_replace, damaged=replace_ship, expired=credit_note, wrong_item=restock
END

# --- Ветка: брак производства (И3) — списать, выдать замену за наш счёт ---
NODE scrap_replace: STEP
  DO "списать брак, выдать замену клиенту за счёт производства"
  INTO scrap_doc
END

# --- Ветка: повреждение при доставке (И4) — замена за счёт доставки ---
NODE replace_ship: STEP
  DO "выдать замену за счёт доставки, оформить претензию перевозчику"
  INTO ship_claim
END

# --- Ветка: просрочка (И3) — списание + кредит-нота ---
NODE credit_note: STEP
  DO "списать просроченный товар, оформить кредит-ноту клиенту"
  INTO credit_doc
END

# --- Ветка: не тот товар — возврат на склад (пересорт) ---
NODE restock: STEP
  DO "принять товар обратно на склад, разобрать пересорт"
  INTO restock_doc
END

# --- Схождение: обновить склад и деньги (A2 + A6) ---
NODE settle: STEP
  DO "провести возврат по складу и деньгам: списания, замены, кредит-ноты"
  INTO settlement
END

# --- Итог: отчёт по возвратам (A7, KPI — доля возвратов) ---
NODE returns_report: STEP
  DO "сформировать отчёт по возвратам: причины, суммы, тренд"
  INTO returns_report_doc
END

EDGES
  intake_return -> verify_return
  verify_return -> classify_return
  classify_return -> fork_return
  fork_return -> scrap_replace [defect]
  fork_return -> replace_ship [damaged]
  fork_return -> credit_note [expired]
  fork_return -> restock [wrong_item]
  scrap_replace -> settle
  replace_ship -> settle
  credit_note -> settle
  restock -> settle
  settle -> returns_report
END
