# Сквозной сценарий №1: дневной цикл обеспечения ресторана (HoReCa)
# Канонический синтаксис Luck (vendor/luck-engine, crate `luck`). Соглашения
# миграции с автономного форка (см. examples_luck/README-migration.md нет —
# фиксирую здесь и одинаково во всех 4 сценариях):
#
#   BRANCH  — нет отдельного узла BRANCH. Ветвление = edges "=>" с меткой
#             [label], сверяемой (регистронезависимо) с выводом узла-источника
#             (обычно CLASSIFY). Реализация: vendor scheduler.rs::edge_is_active.
#   MERGE   — нет отдельного узла MERGE. Схождение веток = edges "~>"
#             (EdgeType::Merge): активация по ЛЮБОМУ исполненному предку, а не
#             по всем — то есть именно то, что нужно после BRANCH (только одна
#             ветка когда-либо исполняется). Обычный STEP-узел с таким входом
#             и есть "точка слияния"; его DO описывает агрегацию.
#             ВАЖНО: нельзя смешивать на одном узле входящие Branch-рёбра с
#             Merge/Seq-рёбрами от разных предков — группы (seq/branch/merge)
#             комбинируются через AND, а нужна чистая OR-семантика на границе
#             слияния. Поэтому оба "хвоста" ветвления сведены к единому типу
#             ребра в точку слияния.
#   VERIFY  — канонический слот на STEP/TASK: `VERIFY checker="имя"`, либо
#             `VERIFY checker="имя", subject="узел"`. `subject` — соглашение
#             luck-pilot (не часть vendor-грамматики, просто ARGS-пара): id
#             узла, чей вывод проверяется; по умолчанию — собственный вывод
#             узла. vendor/luck-engine слот только парсит, не проверяет —
#             enforcement живёт в luck-pilot/src/verify.rs (см. модуль).
#   POLICY  — слот на TOOL (require=...); в этих сценариях не задействован
#             (демо-инструменты без подтверждения), но грамматика поддерживает.

NODE intake: STEP [GENERATIVE]
  DO "принять заказы клиентов HoReCa на день"
  INTO orders
END

NODE plan: STEP [GENERATIVE]
  DO "составить план производства на день с учётом принятых заказов и остатков готовой продукции на складе"
  INTO production_plan
END

NODE stock_check: CLASSIFY [GENERATIVE]
  INPUT "остатки сырья против потребности плана выпуска"
  LABELS ok="хватает", short="нехватка"
  INTO stock_state
END

NODE purchase: STEP [GENERATIVE]
  DO "сформировать заказ поставщику на недостающее сырьё"
  INTO purchase_order
END

NODE produce_ok: STEP [GENERATIVE]
  DO "произвести продукцию по техкартам и плану выпуска (остатков хватило)"
  INTO finished_goods_ok
END

NODE produce_short: STEP [GENERATIVE]
  DO "произвести продукцию по техкартам и плану выпуска (после дозакупки)"
  INTO finished_goods_short
END

NODE pick: STEP [GENERATIVE]
  DO "скомплектовать заказ клиента со склада готовой продукции"
  VERIFY checker="not_empty"
  INTO picked_order
END

NODE dispatch: STEP [GENERATIVE]
  DO "доставить заказ клиенту в согласованное окно, оформить ТТН"
  INTO delivery_note
END

NODE bill: STEP [GENERATIVE]
  DO "выставить счёт, зафиксировать продажу в дебиторке"
  INTO invoice
END

NODE report: STEP [GENERATIVE]
  DO "сформировать OTIF-отчёт дня: вовремя и полностью"
  INTO daily_report
END

EDGES:
  intake -> plan
  plan -> stock_check
  stock_check => produce_ok [хватает]
  stock_check => purchase [нехватка]
  purchase -> produce_short
  produce_ok ~> pick
  produce_short ~> pick
  pick -> dispatch
  dispatch -> bill
  bill -> report
END
