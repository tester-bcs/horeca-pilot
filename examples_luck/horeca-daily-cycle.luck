# Сквозной сценарий №1: дневной цикл обеспечения ресторана (HoReCa)
# Производная от 1+6: модули A1-A7 -> узлы, потоки Среза 3 -> рёбра,
# честность формы (Срез 4) + пороги (Срез 5) -> VERIFY, отказы -> ON_FAIL/REJECT.
# Синтаксис: подмножество Luck-компилятора ai-agent (luck_compile.rs).
# ПЕРЕД ПРОГОНОМ: сверить слот BRANCHES и рёбра с метками с текущим luck_compile.rs
# (точный синтаксис ветвления в Rust-порте).

# --- A5 Торговля: вход ядра (заказ клиента) ---
NODE intake: STEP
  DO "принять заказы клиентов HoReCa на день"
  INTO orders
END

# --- A7 Управление: план выпуска по заказам и остаткам ---
NODE plan: STEP
  DO "составить план производства на день: заказы минус остатки готовой продукции"
  INPUT orders
  INTO production_plan
END

# --- A2 Склад: хватает ли сырья под план (порог Среза 5) ---
NODE stock_check: CLASSIFY
  AS "Ты классификатор остатков склада. Ответь РОВНО одним словом: ok (остатков хватает) или short (не хватает). Никаких пояснений."
  DO "оценить остатки сырья против потребности плана выпуска"
  INPUT production_plan
  INTO stock_state
END

# --- Ветвление: ok -> производство, short -> дозакуп (отдельный BRANCH-узел!) ---
NODE fork: BRANCH
  INPUT stock_state
  BRANCHES ok=produce, short=purchase
END

# --- A1 Закупка: дозакуп недостающего (ветка short) ---
NODE purchase: STEP
  DO "сформировать заказ поставщику на недостающее сырьё"
  INPUT stock_state
  INTO purchase_order
END

# --- A3 Производство: выпуск по техкартам (обе ветки сходятся) ---
NODE produce: STEP
  DO "произвести продукцию по техкартам и плану выпуска"
  INPUT production_plan
  INTO finished_goods
END

# --- A2 Склад: комплектация заказа клиента ---
NODE pick: STEP
  DO "скомплектовать заказ клиента со склада готовой продукции"
  INPUT finished_goods
  INTO picked_order
END

# --- И4: полнота комплектации = заказ (VERIFY на ребре A2 -> A4) ---
NODE verify_full: VERIFY
  VERIFY not_empty INTO picked_order
END

# --- A4 Доставка: отгрузка в окно доставки ---
NODE dispatch: STEP
  DO "доставить заказ клиенту в согласованное окно, оформить ТТН"
  INPUT picked_order
  INTO delivery_note
END

# --- A5/A6 Деньги: счёт, продажа, дебиторка (отсрочка 7-30 дней) ---
NODE bill: STEP
  DO "выставить счёт, зафиксировать продажу в дебиторке"
  INPUT delivery_note
  INTO invoice
END

# --- A7: OTIF-отчёт дня (главный KPI, Срез 5) ---
NODE report: STEP
  DO "сформировать OTIF-отчёт дня: вовремя и полностью"
  INPUT invoice
  INTO daily_report
END

EDGES
  intake -> plan
  plan -> stock_check
  stock_check -> produce [ok]
  stock_check -> purchase [short]
  purchase -> produce
  produce -> pick
  pick -> verify_full
  verify_full -> dispatch
  dispatch -> bill
  bill -> report
END
