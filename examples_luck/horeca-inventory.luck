# Сценарий №3: инвентаризация и списания (HoReCa)
# Соглашения BRANCH/MERGE/VERIFY/POLICY — см. horeca-daily-cycle.luck (шапка).
# TOOL-узлы возвращают JSON: count_api -> {book, actual, allowed}.

NODE freeze: STEP [GENERATIVE]
  DO "заморозить склад для инвентаризации: стоп отгрузок и приёмок"
  INTO freeze_doc
END

NODE count: TOOL [EXTERNAL]
  CALL count_api WITH scope="all"
END

NODE compare: STEP [GENERATIVE]
  DO "сверить учётные остатки с фактическими, зафиксировать расхождения: JSON {book, actual, allowed}"
  INTO diff_data
END

NODE classify_diff: CLASSIFY [GENERATIVE]
  INPUT "расхождение между учётными и фактическими остатками: в пределах нормы или отклонение"
  LABELS ok="норма", deviation="отклонение"
  INTO diff_state
END

NODE write_off: STEP [GENERATIVE]
  DO "списать потери в пределах нормы: просрочка, бой, усушка"
  INTO write_off_doc
END

NODE investigate: STEP [GENERATIVE]
  DO "расследовать крупное расхождение: ошибка учёта, кража, недоприёмка"
  INTO investigation
END

NODE resolve: STEP [GENERATIVE]
  DO "принять решение по расхождению: списать, переоценить, завести на ответственного"
  INTO resolution
END

NODE close_inventory: STEP [GENERATIVE]
  DO "закрыть инвентаризацию: обновить учётные остатки, сформировать акт"
  INTO inventory_act
END

NODE inventory_report: STEP [GENERATIVE]
  DO "сформировать отчёт: потери, расхождения, тренд по периодам"
  INTO inventory_report_doc
END

EDGES:
  freeze -> count
  count -> compare
  compare -> classify_diff
  classify_diff => write_off [норма]
  classify_diff => investigate [отклонение]
  investigate -> resolve
  write_off ~> close_inventory
  resolve ~> close_inventory
  close_inventory -> inventory_report
END
