# Сценарий №4: cash-прогноз и кредитный контроль (A6 Деньги)
# Соглашения BRANCH/MERGE/VERIFY/POLICY — см. horeca-daily-cycle.luck (шапка).
# Денежный контур (И2 — кэш-цикл с дебиторкой 7-30 дней).
# VERIFY: cash_ok {cash, obligations} на самом forecast (собственный вывод),
# credit_ok {limit, outstanding} на отдельном STEP verify_credit — TOOL-узлы
# не имеют слота VERIFY в реестре (только STEP/TASK), поэтому проверка
# TOOL-вывода вынесена в следующий STEP через `subject="check_credit"`.

NODE load_receivables: TOOL [EXTERNAL]
  CALL receivables_api WITH horizon_days=30
END

NODE forecast: STEP [GENERATIVE]
  DO "рассчитать кэш-прогноз на горизонт: JSON {cash, obligations}"
  VERIFY checker="cash_ok"
  INTO cash_forecast
END

NODE classify_risk: CLASSIFY [GENERATIVE]
  INPUT "риск кассового разрыва по кэш-прогнозу"
  LABELS ok="норма", risk="риск"
  INTO risk_state
END

NODE pay_suppliers: STEP [GENERATIVE]
  DO "оплатить поставщикам по графику в пределах кэш-прогноза"
  INTO payments
END

NODE hold_payments: STEP [GENERATIVE]
  DO "заморозить платежи, пересмотреть график, подключить овердрафт/факторинг"
  INTO cash_action
END

NODE check_credit: TOOL [EXTERNAL]
  CALL credit_api WITH clients="hoReCa"
END

NODE verify_credit: STEP [GENERATIVE]
  DO "проверить лимиты клиентов с отсрочкой"
  VERIFY checker="credit_ok", subject="check_credit"
  INTO client_credit
END

NODE settle_plan: SPAWN [GENERATIVE]
  PLAN "разложить платёжный день на подзадачи-узлы STEP (без TOOL): исходящие
        платежи поставщикам, входящие платежи от клиентов, сверка остатка на
        конец дня. Каждый узел -- отдельный STEP с DO и INTO. id узлов должны
        начинаться с префикса settle_ (например settle_outflow, settle_inflow,
        settle_close) и не совпадать ни с одним из уже существующих в графе id:
        load_receivables, forecast, classify_risk, pay_suppliers, hold_payments,
        check_credit, verify_credit, settle_plan, cash_report."
  BUDGET nodes="4", depth="1"
  INTO settle_subgraph
END

NODE cash_report: STEP [GENERATIVE]
  DO "сформировать отчёт: cash-позиция, дебиторка, прогноз, риски"
  INTO cash_report_doc
END

EDGES:
  load_receivables -> forecast
  forecast -> classify_risk
  classify_risk => pay_suppliers [норма]
  classify_risk => hold_payments [риск]
  check_credit -> verify_credit
  pay_suppliers ~> settle_plan
  hold_payments ~> settle_plan
  verify_credit -> settle_plan
  settle_plan -> cash_report
END
